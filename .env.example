# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY. Never expose to the client,
# never prefix with NEXT_PUBLIC_. Used only in trusted server contexts
# (e.g. admin scripts, seed scripts).
SUPABASE_SERVICE_ROLE_KEY=

# Required only to run scripts/seed-admin.mjs. No defaults on purpose —
# pick your own values locally, never commit real ones here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional, used by scripts/seed-admin.mjs (not a credential).
SEED_ORG_NAME=
